# ── Vera Backend — Environment Variables ─────────────────────────────────────
# Copy this file to .env for local development.
# On Railway, set these as environment variables in the service dashboard.

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./vera.db

# PostgreSQL (Railway / production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — the app will refuse to start without this.
SECRET_KEY=dev_secret_change_in_production

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Railway. Any non-"development" value enforces SECRET_KEY.
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel domain):
# CORS_ORIGINS=https://usevera.xyz,https://www.usevera.xyz

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20

# ── API Key Config ────────────────────────────────────────────────────────────
API_KEY_PREFIX=al_live_

# ── Batch / Field Size Limits ────────────────────────────────────────────────
MAX_BATCH_SIZE=100
MAX_JSON_FIELD_SIZE=1000000
MAX_SEARCH_LENGTH=200
