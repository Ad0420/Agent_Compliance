# ── Vera Backend — Environment Variables ─────────────────────────────────────
# Copy this file to .env for local development.
# On Railway, set these as environment variables in the service dashboard.

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./vera.db

# PostgreSQL (Railway / production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — the app will refuse to start without this.
SECRET_KEY=dev_secret_change_in_production

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Railway. Any non-"development" value enforces SECRET_KEY.
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel domain):
# CORS_ORIGINS=https://usevera.xyz,https://www.usevera.xyz

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20
# Set false when AWS WAF rate-based rules are the production limiter.
RATE_LIMIT_ENABLED=true
# Set true only behind trusted proxies/ALB so X-Forwarded-For is trusted.
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# ── Database pool tuning ─────────────────────────────────────────────────────
# Each Gunicorn worker owns a pool, so keep these modest on small RDS instances.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800

# ── Durable jobs (SQS + ECS worker in production) ───────────────────────────
ACTIONLEDGER_JOB_QUEUE_PROVIDER=local
# ACTIONLEDGER_JOB_QUEUE_PROVIDER=sqs
# ACTIONLEDGER_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/vera-prod-jobs

# ── S3 document/export storage ──────────────────────────────────────────────
# Signed BAA PDFs. Bucket should use SSE-KMS and block public access.
# ACTIONLEDGER_BAA_BUCKET=vera-prod-baa-documents
ACTIONLEDGER_BAA_PREFIX=baa/
# ACTIONLEDGER_BAA_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
ACTIONLEDGER_BAA_UPLOAD_MAX_BYTES=10000000

# Async PDF exports. Bucket should use SSE-KMS and block public access.
# ACTIONLEDGER_EXPORT_BUCKET=vera-prod-exports
ACTIONLEDGER_EXPORT_PREFIX=exports/
# ACTIONLEDGER_EXPORT_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...

# ── API Key Config ────────────────────────────────────────────────────────────
API_KEY_PREFIX=al_live_

# ── Batch / Field Size Limits ────────────────────────────────────────────────
MAX_BATCH_SIZE=100
MAX_JSON_FIELD_SIZE=1000000
MAX_SEARCH_LENGTH=200

# ── Clerk auth (dashboard routes only — SDK uses API keys) ───────────────────
# REQUIRED for /v1/dashboard/* routes to work. Without these the dashboard
# endpoints will return 503 — they will NOT silently accept tokens.
# Find these values in your Clerk dashboard under "API Keys → Show JWKS Endpoint".
# CLERK_ISSUER is REQUIRED whenever CLERK_JWKS_URL is set — the app will
# refuse to start otherwise (otherwise a JWT signed by ANY Clerk instance
# whose kid happens to match would be accepted).
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUDIENCE=  # optional, only set if you've configured a custom JWT template
# Authorized parties — Clerk session tokens carry an `azp` claim (frontend
# origin), not `aud`. Setting this rejects tokens from a different Clerk app
# on the same instance. Comma-separated, e.g. https://app.example.com,https://staging.example.com
# CLERK_AUTHORIZED_PARTIES=https://app.usevera.xyz

# ── Clerk webhooks (Workstream E3 — Clerk → backend org bridge) ──────────────
# REQUIRED for POST /v1/clerk/webhooks to accept events. Without this the
# endpoint returns 503 — Vera will NOT silently accept unsigned webhook bodies.
# Find this value in Clerk Dashboard → Webhooks → <your endpoint> → Signing
# Secret. It starts with `whsec_`.
#
# Configure the webhook endpoint in Clerk to point at:
#   https://<your-vera-backend>/v1/clerk/webhooks
# Subscribe to events:
#   organization.created, organization.deleted
#   organizationMembership.created, organizationMembership.updated,
#   organizationMembership.deleted
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Backend API secret key (``sk_live_…`` / ``sk_test_…``). Used by
# ``require_clerk_role`` to consult Clerk's REST API and confirm a cached
# membership's role is still current, defending against:
#   - missed or late ``organizationMembership.updated`` webhooks (an admin
#     demoted in Clerk would otherwise retain admin in the backend until
#     the webhook eventually arrives), and
#   - the ~60 s gap between a user being removed from a Clerk org and the
#     JWT they hold expiring.
# Leave empty to disable the re-check (cached role is trusted indefinitely).
# Find this value in Clerk Dashboard → API Keys → Secret Keys.
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Max age (in seconds) of a cached OrgMembership row before
# ``require_clerk_role`` consults Clerk's REST API. Trades a Clerk API
# round-trip for closing missed-demotion / stale-JWT gaps. Default 300s
# (5 min) — set to 0 to disable.
# MEMBERSHIP_FRESHNESS_SECONDS=300
