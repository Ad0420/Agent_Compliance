# =============================================================================
# Vera frontend environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values for development.
# Never commit `.env.local`. Production values live in Vercel project settings.

# -----------------------------------------------------------------------------
# Clerk (human auth for the dashboard)
# -----------------------------------------------------------------------------
# Publishable key — safe to expose to the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-only. NEVER expose this to the client bundle.
CLERK_SECRET_KEY=sk_test_...

# Optional: customize the Clerk URLs. Sensible defaults work, but Vera maps
# its existing /login and /register paths to Clerk's hosted components.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
