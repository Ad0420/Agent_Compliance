# ── Vera ───────────────────────────────────────────────────────────────────
# Vera production API URL. Use the Railway backend URL for prod demos.
# For local development, set this to http://localhost:8000.
VERA_API_URL=https://api.usevera.xyz

# Per-customer API keys are auto-populated by `bootstrap_orgs.py`.
# Do NOT commit .env.local — it's gitignored.
# VERA_API_KEY_SCRIBEMD=al_live_...
# VERA_API_KEY_TRIAGEGUARD=al_live_...
# VERA_API_KEY_AUTHASSIST=al_live_...

# ── LLM providers ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Mode ───────────────────────────────────────────────────────────────────
# A | B | C — controls the LLM provider and Vera target.
# Override per-run via CLI flag; this is just the default.
SIMULATOR_MODE=A

# Optional: override the default mock-physician approval delay (Mode A).
# Lower = snappier demo; higher = more realistic. Seconds.
DEMO_APPROVAL_DELAY_SECONDS=3
