# TriageGuard demo — environment variables
#
# Copy this file to `.env.local` (gitignored) and fill in the real values.
# Never commit real keys. Both the backend container (triageguard-backend) and
# the frontend container (triageguard-frontend) read from `.env.local` at the
# same directory level as `docker-compose.yml`.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Single passkey shared by every demo session. The backend's /api/auth/login
# does a constant-time compare against this. Changing it invalidates anyone
# already logged in (sessions live in-process anyway).
TRIAGEGUARD_PASSKEY=qwertyuiop24072004

# Display name returned by GET /api/auth/me. The on-call reviewer persona for
# the triage red-flag escalation flow.
TRIAGEGUARD_USER_LABEL=Nurse Rivera, RN

# ── Vera target ───────────────────────────────────────────────────────────────
# The Vera control plane the backend talks to via the Vera SDK. Production for
# the canonical demo. Never point this at a chaos-mode local Vera.
VERA_API_URL=https://api.usevera.xyz

# TriageGuard's per-org API key. Generated by `make bootstrap`, which calls
# `python -m simulator.scripts.bootstrap_orgs --only triageguard --policies` and
# writes the key to `simulator/.env.local`. Copy it from there into this file.
VERA_API_KEY_TRIAGEGUARD=al_live_replace_me

# ── LLM providers ─────────────────────────────────────────────────────────────
# OpenAI runs the triage classifier. Anthropic runs the red-flag detector.
# Both must be live keys for Mode A (demo). The CI mode uses recorded
# cassettes and does not need real keys.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# ── Frontend → backend ────────────────────────────────────────────────────────
# The browser calls the backend directly on the host's port 8002. This URL is
# baked into the Next.js bundle at build time, so it must be the address the
# browser can reach (not the docker-internal hostname).
NEXT_PUBLIC_TRIAGEGUARD_API_URL=http://localhost:8002

# ── Backend tunables (optional) ───────────────────────────────────────────────
# Operational state DB. Lives inside the container under /app unless you mount
# a volume. The Makefile's `clean` target nukes the host-side file too.
TRIAGEGUARD_DB_URL=sqlite+aiosqlite:///./triageguard_backend.db

# Soft cap on nurse review wait. After this many seconds with no decision, the
# worker auto-rejects so the workflow can't block forever.
TRIAGEGUARD_REVIEW_TIMEOUT_SECONDS=300

# Comma-separated CORS origins. Add hosts here if you proxy the frontend.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
