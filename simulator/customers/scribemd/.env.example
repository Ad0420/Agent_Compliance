# ScribeMD demo — environment variables
#
# Copy this file to `.env.local` (gitignored) and fill in the real values.
# Never commit real keys. Both the backend container (scribemd-backend) and the
# frontend container (scribemd-frontend) read from `.env.local` at the same
# directory level as `docker-compose.yml`.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Single passkey shared by every demo session. The backend's /api/auth/login
# does a constant-time compare against this. Changing it invalidates anyone
# already logged in (sessions live in-process anyway).
SCRIBEMD_PASSKEY=qwertyuiop24072004

# Display name returned by GET /api/auth/me.
SCRIBEMD_USER_LABEL=Dr. Adams

# ── Vera target ───────────────────────────────────────────────────────────────
# The Vera control plane the backend talks to via the Vera SDK. Production for
# the canonical demo. Never point this at a chaos-mode local Vera.
VERA_API_URL=https://api.usevera.xyz

# ScribeMD's per-org API key. Generated by `make bootstrap`, which calls
# `python -m simulator.scripts.bootstrap_orgs --only scribemd --policies` and
# writes the key to `simulator/.env.local`. Copy it from there into this file.
VERA_API_KEY_SCRIBEMD=al_live_replace_me

# ── LLM providers ─────────────────────────────────────────────────────────────
# OpenAI is used by the note-drafting agent. Anthropic is used by the
# orders-extraction agent. Both must be live keys for Mode A (demo). The CI
# mode uses recorded cassettes and does not need real keys.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# ── Frontend → backend ────────────────────────────────────────────────────────
# The browser calls the backend directly on the host's port 8001. This URL is
# baked into the Next.js bundle at build time, so it must be the address the
# browser can reach (not the docker-internal hostname).
NEXT_PUBLIC_SCRIBEMD_API_URL=http://localhost:8001

# ── Backend tunables (optional) ───────────────────────────────────────────────
# Operational state DB. Lives inside the container under /app unless you mount
# a volume. The Makefile's `clean` target nukes the host-side file too.
SCRIBEMD_DB_URL=sqlite+aiosqlite:///./scribemd_backend.db

# Soft cap on physician HITL wait. After this many seconds with no decision,
# the worker auto-rejects so the workflow can't block forever.
SCRIBEMD_APPROVAL_TIMEOUT_SECONDS=300

# Comma-separated CORS origins. Add hosts here if you proxy the frontend.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ── W2.1 in-band HITL webhook ─────────────────────────────────────────────────
# Shared secret for incoming Vera webhooks at POST /vera/webhooks. Must match
# the secret Vera was configured with when ScribeMD subscribed. The
# webhook handler computes HMAC-SHA256 over the raw request body and
# constant-time-compares against the X-Vera-Signature header. Missing →
# 503 (fail closed), wrong signature → 401.
SCRIBEMD_VERA_WEBHOOK_SECRET=replace-me-with-the-subscription-secret
